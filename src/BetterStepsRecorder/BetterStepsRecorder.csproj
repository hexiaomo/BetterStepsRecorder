<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>BetterStepsRecorder</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>stepsrecorder_r2p_icon.ico</ApplicationIcon>
	<Version>2026.3.29.2040</Version>
    <AssemblyName>StepRecorder</AssemblyName>
    <Product>步骤记录器</Product>
    <Company>StepRecorder</Company>
    <Title>步骤记录器 — 鼠标点击截图 + 标注导出</Title>
    <Description>录制鼠标点击步骤并自动截图，支持指针高亮、文字框、马赛克编辑，导出长图 / 图片序列 / PDF / HTML。</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="PictureBoxTools.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="stepsrecorder_r2p_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

    <ItemGroup>
      <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>